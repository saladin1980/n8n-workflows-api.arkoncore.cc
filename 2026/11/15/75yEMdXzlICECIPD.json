{"nodes":[{"id":"232ac0b9-17d3-4e3c-a008-114e48d9051b","name":"Manufacturer Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[240,304],"parameters":{"path":"test-zzz/vt2-mfr-copy","authentication":"basicAuth","responseMode":"responseNode","options":{}},"webhookId":"54b5e50f-2591-40de-a74f-a015990d29ed","credentials":{"httpBasicAuth":{"id":"LF2cxhn6JCJek4Yw","name":"api-auth-token-wE..sear"}}},{"id":"8ebb8aaf-ef0d-47ef-bc97-b18aae94b84d","name":"Resolve & Fetch","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[464,304],"parameters":{"operation":"executeQuery","query":"SELECT\n  (ml.canonical_name IS NOT NULL AND ml.canonical_name != '') AS found,\n  v.input_slug,\n  ml.canonical_name,\n  ml.slug AS mfr_slug,\n  COALESCE(\n    (\n      SELECT json_agg(\n        json_build_object(\n          'slug', ed.slug,\n          'name', ed.name,\n          'entity_type', ed.entity_type,\n          'category', ed.category\n        )\n        ORDER BY ed.entity_type, ed.name\n      )\n      FROM entity_display ed\n      WHERE ed.manufacturer = ml.canonical_name\n    ),\n    '[]'::json\n  ) AS products\nFROM (VALUES ($1::text)) AS v(input_slug)\nLEFT JOIN manufacturer_lookup ml ON ml.slug = v.input_slug","options":{"queryBatching":"independently","queryReplacement":"={{ $json.query.slug }}"}},"credentials":{"postgres":{"id":"ZdartBUBwtouNDDX","name":"scuser-full"}},"alwaysOutputData":true},{"id":"8bdfb763-aa8a-4ff3-a5a9-3ca95d4127cc","name":"Group Results","type":"n8n-nodes-base.code","typeVersion":2,"position":[688,304],"parameters":{"jsCode":"const row = $input.first().json;\n\nif (!row.found) {\n  return [{ json: { error: 'manufacturer not found', slug: row.input_slug } }];\n}\n\nconst entityTypeFilter = $('Manufacturer Webhook').first().json.query?.entity_type || '';\n\nconst products = {};\nlet total = 0;\nfor (const p of (row.products || [])) {\n  if (entityTypeFilter && p.entity_type !== entityTypeFilter) continue;\n  if (!products[p.entity_type]) products[p.entity_type] = [];\n  products[p.entity_type].push({ slug: p.slug, name: p.name, category: p.category });\n  total++;\n}\n\nreturn [{ json: { slug: row.mfr_slug, canonical_name: row.canonical_name, products, total } }];"}},{"id":"061bff16-26bd-40b8-b659-f815a001bc52","name":"Respond Manufacturer","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[912,304],"parameters":{"respondWith":"allIncomingItems","options":{}}},{"id":"1d3331a8-4fa8-4446-b68c-46044f643cbd","name":"Track Request","type":"n8n-nodes-base.executeWorkflow","typeVersion":1.4,"position":[1136,304],"parameters":{"mode":"once","source":"database","workflowId":{"__rl":true,"mode":"id","value":"VL77amIzEiLm7hf0","cachedResultName":"v3 Track Request"},"workflowInputs":{"mappingMode":"defineBelow","value":{"endpoint":"v3/manufacturer","method":"GET","q":"={{ null }}","slug":"={{ $('Manufacturer Webhook').first().json.query.slug ?? null }}","asked_slug":"={{ $('Manufacturer Webhook').first().json.query.slug ?? null }}","variant_slug":"={{ null }}","filters":"={{ Object.fromEntries(Object.entries($('Manufacturer Webhook').first().json.query ?? {}).filter(e => e[0] !== 'slug')) }}","status_hint":"={{ $('Group Results').first().json.error ? 'not-found' : 'ok' }}","error":"={{ null }}","result_count":"={{ $('Group Results').first().json.error ? 0 : ($('Group Results').first().json.total ?? 0) }}","top_results":"={{ $('Group Results').first().json.error ? [] : [ { slug: $('Group Results').first().json.slug, type: 'company', name: $('Group Results').first().json.canonical_name } ] }}","duration_ms":"={{ null }}","reason":"={{ $('Manufacturer Webhook').first().json.headers['x-arkon-reason'] ?? null }}","source":"={{ $('Manufacturer Webhook').first().json.headers['x-arkon-source'] ?? null }}","auth":"={{ $('Manufacturer Webhook').first().json.headers['x-arkon-auth'] ?? null }}","user":"={{ $('Manufacturer Webhook').first().json.headers['x-arkon-user'] ?? null }}","view":"={{ $('Ma