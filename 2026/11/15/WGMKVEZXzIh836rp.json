ategory });\n  total++;\n}\n\nreturn [{ json: { slug: row.mfr_slug, canonical_name: row.canonical_name, products, total } }];"},"id":"f150f98b-2221-4fdd-9337-74233ba49f8f","name":"Group Results","type":"n8n-nodes-base.code","typeVersion":2,"position":[688,304]},{"id":"f4acecdc-5f52-462a-aef8-e41f2faa37c4","name":"Respond Manufacturer","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[912,304],"parameters":{"respondWith":"allIncomingItems","options":{}},"notes":"View tracking part 2, step (a): returns all incoming items, exactly what lastNode/allEntries returned. Byte-compared on a copy before going live."},{"id":"13574dfd-bcf3-4f45-bf42-fa60d26a2aa2","name":"Track Request","type":"n8n-nodes-base.executeWorkflow","typeVersion":1.4,"position":[1136,304],"parameters":{"mode":"once","source":"database","workflowId":{"__rl":true,"mode":"id","value":"VL77amIzEiLm7hf0","cachedResultName":"v3 Track Request"},"workflowInputs":{"mappingMode":"defineBelow","value":{"endpoint":"v3/manufacturer","method":"GET","q":"={{ null }}","slug":"={{ $('Manufacturer Webhook').first().json.query.slug ?? null }}","asked_slug":"={{ $('Manufacturer Webhook').first().json.query.slug ?? null }}","variant_slug":"={{ null }}","filters":"={{ Object.fromEntries(Object.entries($('Manufacturer Webhook').first().json.query ?? {}).filter(e => e[0] !== 'slug')) }}","status_hint":"={{ $('Group Results').first().json.error ? 'not-found' : 'ok' }}","error":"={{ null }}","result_count":"={{ $('Group Results').first().json.error ? 0 : ($('Group Results').first().json.total ?? 0) }}","top_results":"={{ $('Group Results').first().json.error ? [] : [ { slug: $('Group Results').first().json.slug, type: 'company', name: $('Group Results').first().json.canonical_name } ] }}","duration_ms":"={{ null }}","reason":"={{ $('Manufacturer Webhook').first().json.headers['x-arkon-reason'] ?? null }}","source":"={{ $('Manufacturer Webhook').first().json.headers['x-arkon-source'] ?? null }}","auth":"={{ $