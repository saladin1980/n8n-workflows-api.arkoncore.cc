{"nodes":[{"id":"c42a84ff-7a40-4d87-a0bd-bfd263af0851","name":"Webhook adv-search","type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-1184,1344],"parameters":{"path":"test-zzz/vt2-adv-copy","responseMode":"responseNode","options":{}},"webhookId":"48adf28c-1844-45f8-a4d6-a06fdfd3241b"},{"id":"c867ab82-3ee3-4659-b645-748de7f1cc11","name":"Sanitize & Normalize","type":"n8n-nodes-base.code","typeVersion":2,"position":[-960,1344],"parameters":{"jsCode":"// ── Advanced Search: Sanitize & Normalize ──────────────────────────────\nconst query = $json.query || {};\n\nconst MAX_Q_LENGTH = 150;\nconst MAX_LIMIT    = 100;\nconst MAX_OFFSET   = 10000;\n\n// ── q ───────────────────────────────────────────────────────────────────\nconst raw_q = String(query.q || '').trim().toLowerCase();\nlet q_norm  = null;\nlet q_error = null;\n\nif (raw_q.length === 0) {\n  q_error = 'missing';\n} else if (raw_q.length < 2) {\n  q_error = 'too_short';\n} else if (raw_q.length > MAX_Q_LENGTH) {\n  q_error = 'too_long';\n} else {\n  q_norm = raw_q;\n}\n\n// ── category ────────────────────────────────────────────────────────────\n// Accept any entity_type slug (letters, digits, underscores only — safe for parameterized query)\nconst raw_cat = String(query.category || '').trim().toLowerCase();\nlet category_norm  = '*';\nlet category_error = '';\n\nif (raw_cat.length > 0) {\n  if (/^[a-z0-9_]+$/.test(raw_cat)) {\n    category_norm = raw_cat;\n  } else {\n    category_error = raw_cat;\n  }\n}\n\n// ── limit / offset ──────────────────────────────────────────────────────\nconst limit_norm  = Math.min(Math.max(parseInt(query.limit)  || 25, 1), MAX_LIMIT);\nconst offset_norm = Math.min(Math.max(parseInt(query.offset) || 0,  0), MAX_OFFSET);\n\nreturn {\n  json: {\n    q_norm,\n    q_error,\n    category_norm,\n    category_error,\n    limit_norm,\n    offset_norm\n  }\n};"}},{"id":"93fcc377-cd37-4d45-9a08-c214d2c078c8","name":"Validate Q","type":"n8n-nodes-base.if","typeVersion":2.3,"posi