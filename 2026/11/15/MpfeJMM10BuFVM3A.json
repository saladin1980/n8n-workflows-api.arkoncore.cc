{"nodes":[{"id":"3bd3a6b4-f1ef-42f0-800f-f7a9f305ddd9","name":"Webhook","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[160,304],"parameters":{"path":"test-zzz/vt2-lookup-copy","authentication":"basicAuth","responseMode":"responseNode","options":{}},"webhookId":"3be78cf8-5928-45d3-bd4f-a55dfbeaa580","credentials":{"httpBasicAuth":{"id":"LF2cxhn6JCJek4Yw","name":"api-auth-token-wE..sear"}}},{"id":"79db6b55-9d4c-4e81-9c8b-a8a6c60c72ab","name":"Lookup Entity","type":"n8n-nodes-base.postgres","typeVersion":2.5,"position":[336,304],"parameters":{"operation":"executeQuery","query":"WITH direct AS (\n    SELECT\n      ed.slug,\n      ed.entity_type,\n      ed.name,\n      ed.manufacturer,\n      ed.category,\n      ed.uex_id,\n      ed.is_base_variant,\n      ed.payload,\n      ed.built_at,\n      NULL::text AS kb_blurb,\n      NULL::text AS variant_slug,\n      ml.slug AS manufacturer_slug\n    FROM entity_display ed\n    LEFT JOIN manufacturer_lookup ml ON ml.canonical_name = ed.manufacturer\n    WHERE ed.slug = $1\n      AND ($2 = '*' OR ed.entity_type = $2)\n    ORDER BY CASE ed.entity_type\n      WHEN 'vehicle'        THEN 0\n      WHEN 'ground_vehicle' THEN 1\n      WHEN 'weapon'         THEN 2\n      WHEN 'armor'          THEN 3\n      WHEN 'component'      THEN 4\n      ELSE 5\n    END\n  ),\n  source_slug_fallback AS (\n    SELECT\n      ed.slug,\n      ed.entity_type,\n      ed.name,\n      ed.manufacturer,\n      ed.category,\n      ed.uex_id,\n      ed.is_base_variant,\n      ed.payload,\n      ed.built_at,\n      NULL::text AS kb_blurb,\n      NULL::text AS variant_slug,\n      ml.slug AS manufacturer_slug\n    FROM entity_display ed\n    LEFT JOIN manufacturer_lookup ml ON ml.canonical_name = ed.manufacturer\n    WHERE ed.payload->>'source_slug' = $1\n      AND ($2 = '*' OR ed.entity_type = $2)\n    ORDER BY CASE ed.entity_type\n      WHEN 'vehicle'        THEN 0\n      WHEN 'ground_vehicle' THEN 1\n      WHEN 'weapon'         THEN 2\n      WHEN 'armor'          THEN 3\n      WHEN 'component'      THEN 4\n      ELSE 5\n    END\n  ),\n  variant_fallback AS (\n    SELECT\n      ed.slug,\n      ed.entity_type,\n      ed.name,\n      ed.manufacturer,\n      ed.category,\n      ed.uex_id,\n      ed.is_base_variant,\n      ed.payload,\n      ed.built_at,\n      NULL::text AS kb_blurb,\n      $1::text AS variant_slug,\n      ml.slug AS manufacturer_slug\n    FROM entity_display ed\n    LEFT JOIN manufacturer_lookup ml ON ml.canonical_name = ed.manufacturer\n    WHERE ed.entity_type = 'vehicle'\n      AND ed.payload->'variants' @> jsonb_build_array(jsonb_build_object('slug', $1))\n  )\n  SELECT * FROM direct\n  UNION ALL\n  SELECT * FROM source_slug_fallback\n  WHERE NOT EXISTS (SELECT 1 FROM direct)\n  UNION ALL\n  SELECT * FROM variant_fallback\n  WHERE NOT EXISTS (SELECT 1 FROM direct)\n    AND NOT EXISTS (SELECT 1 FROM source_slug_fallback)","options":{"queryBatching":"independently","queryReplacement":"={{ $json.query.slug }},{{  $json.query.entity_type ?? '*' }}"}},"credentials":{"postgres":{"id":"rAV3Mbnk3YkJ5WmA","name":"scuser_ro"}}},{"id":"8871eaef-f77a-4812-ab7f-229fe21b0e4e","name":"If","type":"n8n-nodes-base.if","typeVersion":2.3,"position":[496,304],"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict","version":3},"conditions":[{"id":"85e42a8d-e40a-405f-a6c3-61ccb5600173","leftValue":"={{ $input.all().filter(item => item.json.slug != null).length > 0 }}","rightValue":"","operator":{"type":"boolean","operation":"true","singleValue":true}}],"combinator":"and"},"options":{}}},{"id":"961fa0dd-8d70-4735-bf23-0f41d1667224","name":"Respond Found output the data","type":"n8n-nodes-base.respondToWebhook","typeVersion":1.5,"position":[704,224],"parameters":{"respondWith":"json","responseBody":"={{ $('Lookup Entity').all().map(i => i.json) }}","options":{}}},{"id":"ed117b3e-efaa-471a-8b55-75ce015e29df","name":"Track Request","type":"n8n-nodes-base.executeWorkflow","