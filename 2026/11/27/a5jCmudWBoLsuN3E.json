{"nodes":[{"parameters":{"path":"v3/adv-search","authentication":"basicAuth","responseMode":"responseNode","options":{}},"type":"n8n-nodes-base.webhook","typeVersion":2.1,"position":[-1184,1344],"id":"94cfab81-209a-413e-bd93-6844661736f9","name":"Webhook adv-search","webhookId":"adv-search-webhook-001","credentials":{"httpBasicAuth":{"id":"LF2cxhn6JCJek4Yw","name":"api-auth-token-wE..sear"}}},{"parameters":{"jsCode":"// ── Advanced Search: Sanitize & Normalize ──────────────────────────────\nconst query = $json.query || {};\n\nconst MAX_Q_LENGTH = 150;\nconst MAX_LIMIT    = 100;\nconst MAX_OFFSET   = 10000;\n\n// ── q ───────────────────────────────────────────────────────────────────\nconst raw_q = String(query.q || '').trim().toLowerCase();\nlet q_norm  = null;\nlet q_error = null;\n\nif (raw_q.length === 0) {\n  q_error = 'missing';\n} else if (raw_q.length < 2) {\n  q_error = 'too_short';\n} else if (raw_q.length > MAX_Q_LENGTH) {\n  q_error = 'too_long';\n} else {\n  q_norm = raw_q;\n}\n\n// ── category ────────────────────────────────────────────────────────────\n// Accept any entity_type slug (letters, digits, underscores only — safe for parameterized query)\nconst raw_cat = String(query.category || '').trim().toLowerCase();\nlet category_norm  = '*';\nlet category_error = '';\n\nif (raw_cat.length > 0) {\n  if (/^[a-z0-9_]+$/.test(raw_cat)) {\n    category_norm = raw_cat;\n  } else {\n    category_error = raw_cat;\n  }\n}\n\n// ── limit / offset ──────────────────────────────────────────────────────\nconst limit_norm  = Math.min(Math.max(parseInt(query.limit)  || 25, 1), MAX_LIMIT);\nconst offset_norm = Math.min(Math.max(parseInt(query.offset) || 0,  0), MAX_OFFSET);\n\nreturn {\n  json: {\n    q_norm,\n    q_error,\n    category_norm,\n    category_error,\n    limit_norm,\n    offset_norm\n  }\n};"},"type":"n8n-nodes-base.code","typeVersion":2,"position":[-960,1344],"id":"5042e2bf-2c7c-41d1-a3b5-374d61938451","name":"Sanitize & Normalize"},{"parameters":{"c